{
  "name": "@talabisaac/grok-build-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for the xAI Grok Build CLI (grok) — exposes Grok to any MCP client by wrapping the local grok CLI's headless mode.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "grok-build-mcp-server": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "grok",
    "grok-build",
    "xai",
    "cli",
    "ai",
    "llm"
  ],
  "author": "TripleA Lab (Yoon Sang Hoon) <isaac@triplealab.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a3lab01create-bit/grok-build-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/a3lab01create-bit/grok-build-mcp-server/issues"
  },
  "homepage": "https://github.com/a3lab01create-bit/grok-build-mcp-server#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.24.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.6.0"
  }
}
